# You only need ONE provider to start. Anthropic is the default.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Ollama runs locally. No key, no signup, no cost.
# Only needed if you use a model like: ollama/llama3
OLLAMA_HOST=http://localhost:11434

# Where your company lives (agents, voice, inbox, outbox).
ORQ_BUSINESS_DIR=business

# Where generated run records and the index live. Gitignored.
ORQ_DATA_DIR=data

