# The local mock is deterministic. Set this to a future adapter when enabled.
ORQ_PROVIDER=mock

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Ollama runs locally. No key, no signup, no cost.
# Set ORQ_PROVIDER=ollama to use the local adapter.
OLLAMA_HOST=http://localhost:11434
ORQ_OLLAMA_MODEL=qwen3:1.7b
ORQ_OLLAMA_NUM_PREDICT=120
ORQ_OLLAMA_THINK=false

# Where your company lives (agents, voice, inbox, outbox).
ORQ_BUSINESS_DIR=business

# Where generated run records and the index live. Gitignored.
ORQ_DATA_DIR=data
